{
  "schema": 2,
  "version": 3,
  "_note": "Schema 2: the bottom tab bar is a kind 'bar' target (mode rebuild or patch; see rules/Bar.kt). Tab shapes come from the S1 dumps (Instagram tab_bar with view ids, YouTube bottom_bar_container with description-only tabs). A hide cond without a container patches only when it names a viewId (exact); a description alone never does. mode patch is the first response to a bad bar. Tune with Inspector dumps, bump 'version', publish this file.",
  "apps": {
    "com.instagram.android": [
      {
        "minVersionCode": 0,
        "maxVersionCode": null,
        "targets": [
          {"id":"ig_bar","kind":"bar","feature":"reels","mode":"rebuild","bar":[{"viewId":"tab_bar"}],"hide":[{"viewId":"clips_tab"},{"desc":"Reels"}],"minTabs":4,"maxTabs":6,"coverLight":"#FFFFFF","coverDark":"#0C1014"},
          {
            "id": "ig_reels_tab",
            "kind": "block",
            "feature": "reels",
            "any": [
              {
                "viewId": "clips_tab",
                "selected": true
              },
              {
                "desc": "Reels",
                "selected": true,
                "className": "FrameLayout"
              }
            ]
          },
          {
            "id": "ig_reels_viewer",
            "kind": "block",
            "feature": "reels",
            "dmEligible": true,
            "swipeViewIds": [
              "com.instagram.android:id/clips_viewer_view_pager"
            ],
            "any": [
              {
                "viewId": "clips_viewer_view_pager",
                "minHeightFrac": 0.5,
                "minWidthFrac": 0.9
              },
              {
                "viewIdRegex": "clips_viewer.*(pager|container)",
                "minHeightFrac": 0.5,
                "minWidthFrac": 0.9
              }
            ]
          },
          {
            "id": "ig_dm_thread",
            "kind": "marker",
            "feature": "dm",
            "any": [
              {
                "viewId": "row_thread_composer_edittext"
              },
              {
                "viewIdRegex": "direct_thread|thread_composer"
              },
              {
                "viewId": "message_list"
              }
            ]
          },
          {
            "id": "ig_caught_up",
            "kind": "block",
            "feature": "caughtup",
            "action": "tap",
            "tapViewId": "com.instagram.android:id/feed_tab",
            "any": [
              {
                "textContains": "all caught up",
                "maxTopFrac": 0.4
              },
              {
                "text": "Suggested posts",
                "maxTopFrac": 0.4
              },
              {
                "descContains": "all caught up",
                "maxTopFrac": 0.4
              }
            ]
          }
        ]
      }
    ],
    "com.google.android.youtube": [
      {
        "minVersionCode": 0,
        "maxVersionCode": null,
        "targets": [
          {"id":"yt_bar","kind":"bar","feature":"shorts","mode":"rebuild","bar":[{"viewId":"bottom_bar_container"}],"hide":[{"desc":"Shorts"}],"noSelect":[{"desc":"Create"}],"minTabs":4,"maxTabs":6,"coverLight":"#FFFFFF","coverDark":"#0F0F0F"},
          {
            "id": "yt_shorts_player",
            "kind": "block",
            "feature": "shorts",
            "any": [
              {
                "viewId": "reel_recycler",
                "minHeightFrac": 0.5
              },
              {
                "viewId": "reel_player_page_container"
              },
              {
                "viewId": "reel_watch_player"
              },
              {
                "viewIdRegex": "reel_(watch|player)"
              }
            ]
          },
          {
            "id": "yt_shorts_tab",
            "kind": "block",
            "feature": "shorts",
            "any": [
              {
                "desc": "Shorts",
                "selected": true
              }
            ]
          }
        ]
      }
    ]
  }
}
