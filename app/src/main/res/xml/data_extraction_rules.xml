<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ cloud backup and device transfer. The bar's saved pictures and Inspector dumps stay on this phone. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="bar-cache/" />
        <exclude domain="file" path="dumps/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="bar-cache/" />
        <exclude domain="file" path="dumps/" />
    </device-transfer>
</data-extraction-rules>
